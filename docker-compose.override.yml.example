# Copy to docker-compose.override.yml for local development
#
# Usage:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker-compose up -d
#
# Default login: admin / umami (change immediately!)

services:
  umami:
    build:
      context: .
    environment:
      DATABASE_URL: postgresql://umami:${DB_PASSWORD:-umami}@db:5432/umami
      # Generate a secure secret: openssl rand -base64 32
      APP_SECRET: local-dev-secret-change-in-production
      # Optional: Enable debug logging
      # LOG_QUERY: 1
    ports:
      - "3000:3000"

  db:
    ports:
      # Expose PostgreSQL for local debugging
      - "5432:5432"
